   "source": [
    "#Exception Handling using ValueError\n",
    "try:\n",
    "    marks = int(input(\"Enter your marks: \"))\n",
    "\n",
    "    if marks < 0 or marks > 100:\n",
    "        raise ValueError(\"Invalid marks\")\n",
    "\n",
    "    print(\"Marks:\", marks)\n",
    "\n",
    "except ValueError as e:\n",
    "    print(\"Error:\", e)"
   ]
